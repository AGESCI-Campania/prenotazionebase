# Tana — variabili di PRODUZIONE.
# scripts/installa.sh copia questo file in .env (chmod 600) e genera i segreti; non
# sovrascrive mai un .env esistente. scripts/aggiorna.sh si ferma se una release aggiunge
# qui variabili non ancora presenti in .env. Dopo ogni modifica a .env: docker compose up -d
# (ricrea i container; restart non rilegge le variabili).

# --- Django -----------------------------------------------------------------------------
# Generata da installa.sh. Attivare DJANGO_DEBUG solo per diagnosi puntuali.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
# Indirizzo pubblico (V-14 della specifica): il primo host è anche il dominio del Site Django.
# Se si usa anche www.<host>, il redirect lo fa Caddy: qui basta l'host principale.
ALLOWED_HOSTS=baseaiello.agescicampania.net
CSRF_TRUSTED_ORIGINS=https://baseaiello.agescicampania.net
BASE_URL=https://baseaiello.agescicampania.net

# --- Database (container db) ------------------------------------------------------------
# POSTGRES_PASSWORD generata da installa.sh; DATABASE_URL è composta in docker-compose.yml.
POSTGRES_DB=tana
POSTGRES_USER=tana
POSTGRES_PASSWORD=

# --- SSO AGESCI Campania (Sestante) -----------------------------------------------------
# Client ID e Client Secret del provider di Tana, da
# https://auth.agescicampania.net/if/admin/#/core/providers → Tana → modifica.
# Vuoti = pulsante "Accedi con SSO AGESCI Campania" nascosto (l'app parte comunque).
SOCIAL_SESTANTE_CLIENT_ID=
SOCIAL_SESTANTE_CLIENT_SECRET=

# --- Email (D-29) -------------------------------------------------------------------------
# Casella dedicata @agescicampania.net (Google Workspace); metodo di invio: V-16.
# Configurano il mailer "default" di Django (MAILERS in config/settings/base.py).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Nome con cui Tana si presenta al server SMTP (EHLO). Con il relay di Google Workspace
# (EMAIL_HOST=smtp-relay.gmail.com) usare il nome del server, es. srv2.agescicampania.net;
# vuoto = nome del container (va bene con smtp.gmail.com).
EMAIL_EHLO=
DEFAULT_FROM_EMAIL=Tana - Base Scout Gianni Sabatino <prenotazioni@agescicampania.net>
SERVER_EMAIL=prenotazioni@agescicampania.net
EMAIL_REPLY_TO=baseaiellodelsabato@campania.agesci.it
# Notifiche errori 500: indirizzi separati da virgola (vuoto = disabilitate)
ADMIN_EMAILS=

# --- Scheduler (scadenze automatiche) ---------------------------------------------------
SCHEDULER_INTERVALLO=300

# --- Backup notturno (scripts/backup.sh, timer prenotazionebase-backup.timer) ------------
# Cartella degli archivi (relativa al repo o assoluta) e giorni di conservazione.
BACKUP_DIR=backups
BACKUP_GIORNI=14
