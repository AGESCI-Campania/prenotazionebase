# Sviluppo locale: cp .env.dev.example .env.dev
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-insecure-cambiami
DATABASE_URL=postgres://tana:tana@localhost:5432/tana
BASE_URL=http://localhost:8000

# SSO Sestante: vuoti = pulsante nascosto. Per provarlo in locale serve un provider di
# sviluppo separato (mai redirect localhost nel provider di produzione): chiederlo ad Andrea.
SOCIAL_SESTANTE_CLIENT_ID=
SOCIAL_SESTANTE_CLIENT_SECRET=

# Email in console (vedi config/settings/dev.py); true = a Mailpit (http://localhost:8025)
EMAIL_MAILPIT=false
SCHEDULER_INTERVALLO=60
